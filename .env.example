# Copy to .env and fill in. Never commit real credentials.
# Local Docker (default) — leave password empty:
FALKOR_HOST=localhost
FALKOR_PORT=6379
FALKOR_GRAPH=fraudlens
FALKOR_PASSWORD=

# FalkorDB Cloud (from your instance dashboard):
# FALKOR_HOST=<your-instance>.falkordb.cloud
# FALKOR_PORT=6379
# FALKOR_USER=default
# FALKOR_PASSWORD=<paste from cloud console — keep secret>
